---
import { Image, getImage } from 'astro:assets';
import otto from '../assets/logo/otto-oso.png';
import originalLogoFile from '../assets/logo/otto.png';
import { site, whatsapp } from '../data/site.js';

// The wordmark is cut out of the whole logo by the viewBox below, so the file keeps its
// 502 x 502 px; as WebP it weighs a fraction of the PNG on every page.
const originalLogo = await getImage({ src: originalLogoFile, format: 'webp', quality: 90 });

const navigation = [
  { label: 'Eventos', href: '/eventos/' },
  { label: 'Productos', href: '/products/' },
  { label: 'Nosotras', href: '/nosotras/' },
];
const social = [
  { label: 'Instagram', href: site.instagram, icon: 'M5 2.5h6A2.5 2.5 0 0 1 13.5 5v6a2.5 2.5 0 0 1-2.5 2.5H5A2.5 2.5 0 0 1 2.5 11V5A2.5 2.5 0 0 1 5 2.5zM8 5.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8zM11.2 4.7h.01' },
  { label: 'TikTok', href: site.tiktok, icon: 'M9.6 2.5v7.4a2.7 2.7 0 1 1-2.7-2.7M9.6 2.5c.2 1.9 1.4 3.1 3.3 3.3' },
  { label: 'WhatsApp', href: whatsapp('Hola Ottoke.'), icon: 'M8 2.3a5.7 5.7 0 0 0-4.9 8.6l-.8 2.8 2.9-.8A5.7 5.7 0 1 0 8 2.3zM6.2 5.9c-.2 2 1.9 4.1 3.9 3.9' },
];
---

<header class="site-header" id="top">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Ottoke, volver al inicio">
      <Image src={otto} alt="" width={52} height={55} loading="eager" />
      <svg class="site-header__wordmark" viewBox="145 380 245 75" width="116" height="36" aria-hidden="true">
        <image href={originalLogo.src} width="502" height="502" />
      </svg>
    </a>
    <!-- These sections become links when their pages exist. -->
    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul>{navigation.map(({ label, href }) => <li>{href ? <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a> : <span>{label}</span>}</li>)}</ul>
    </nav>
    <nav class="site-header__social" aria-label="Redes sociales">
      {social.map((link) => (
        <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon} /></svg>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* The same header on every page, the homepage included: its gradient ends in the torn
     edge of the other prints and overlaps whatever comes below. The outline and the paper
     rim are the two images in assets/tear */
  .site-header {
    position: relative;
    z-index: 1;
    color: var(--color-ink);
  }
  .site-header::before,
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0 0 calc(-1 * var(--tear-overlap));
    z-index: -1;
    pointer-events: none;
  }
  .site-header::before {
    background: linear-gradient(105deg,
      color-mix(in oklab, var(--color-durazno) 35%, var(--color-hueso)),
      var(--color-hueso) 48%,
      color-mix(in oklab, var(--color-oliva) 35%, var(--color-hueso)));
    mask-image: linear-gradient(black, black), url('../assets/tear/tear-mask.png');
    mask-size: 100% calc(100% - var(--tear-band) + 1px), 100% var(--tear-band);
    mask-position: top, bottom;
    mask-repeat: no-repeat;
  }
  .site-header::after {
    background: url('../assets/tear/tear-rim.png') bottom / 100% var(--tear-band) no-repeat;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-6);
    min-height: 90px;
    padding: var(--space-3) var(--gutter);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }
  .site-header__brand:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 5px; border-radius: 4px; }
  .site-header__brand img { width: 52px; height: auto; }
  .site-header__wordmark { display: block; width: 116px; height: auto; overflow: hidden; }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-label);
  }
  .site-header__nav a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-decoration: none; }
  .site-header__nav a:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .site-header__nav a:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 4px; }
  .site-header__social {
    display: flex;
    justify-self: end;
  }
  .site-header__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: inherit;
    transition: background-color 0.2s;
  }
  .site-header__social a:hover {
    background: color-mix(in oklab, var(--color-ink) 8%, transparent);
  }
  .site-header__social a:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 2px; }
  /* 900px, not the project's 720: the homepage header folds there and this one must match it */
  @media (max-width: 900px) {
    .site-header__inner { grid-template-columns: 1fr auto; gap: 4px 12px; }
    .site-header__brand { gap: 8px; }
    .site-header__brand img { width: 36px; }
    .site-header__wordmark { width: 88px; }
    .site-header__nav { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
    .site-header__nav ul { gap: clamp(20px, 6vw, 48px); }
    .site-header__social { grid-column: 2; grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__social a { transition: none; }
  }
</style>
