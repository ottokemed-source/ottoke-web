---
import { Image } from 'astro:assets';
import otto from '../assets/logo/otto-oso.png';
// the hand-written name of the logo, cut from the brand manual (page 7, monochrome logo)
import wordmark from '../assets/logo/ottoke-wordmark.png';
import { site, whatsapp } from '../data/site.js';

const explore = [
  { label: 'Eventos', href: '/eventos/' },
  { label: 'Norigae', href: '/norigae/' },
  { label: 'Horquillas', href: '/horquillas/' },
  { label: 'Kimchi', href: '/kimchi/' },
  { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes/' },
];

// line drawings of each network's mark, in the same hand as the other small icons
const meet = [
  {
    label: 'Instagram',
    href: site.instagram,
    icon: 'M5 2.5h6A2.5 2.5 0 0 1 13.5 5v6a2.5 2.5 0 0 1-2.5 2.5H5A2.5 2.5 0 0 1 2.5 11V5A2.5 2.5 0 0 1 5 2.5zM8 5.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8zM11.2 4.7h.01',
  },
  {
    label: 'TikTok',
    href: site.tiktok,
    icon: 'M9.6 2.5v7.4a2.7 2.7 0 1 1-2.7-2.7M9.6 2.5c.2 1.9 1.4 3.1 3.3 3.3',
  },
  {
    // the number shows as text, as the Organization data gives it (SEO-AI.md, points 14 and 21)
    label: `WhatsApp ${site.phoneDisplay}`,
    href: whatsapp('Hola Ottoke.'),
    icon: 'M8 2.3a5.7 5.7 0 0 0-4.9 8.6l-.8 2.8 2.9-.8A5.7 5.7 0 1 0 8 2.3zM6.2 5.9c-.2 2 1.9 4.1 3.9 3.9',
  },
];
---

<footer class="footer">
  <div class="footer__color" aria-hidden="true"></div>
  <Image class="footer__name" src={wordmark} alt="Ottoke!" widths={[320, 640]} sizes="(min-width: 720px) 19rem, 60vw" />
  <div class="footer__main">
    <div class="footer__story">
      <p>Cultura que une,<br />enseña y transforma.</p>
      <small>Cultura coreana en {site.city}, Colombia.</small>
      <Image class="footer__logo" src={otto} alt="Otto, el oso de Ottoke" width={176} />
    </div>
    <nav class="footer__nav" aria-labelledby="explora">
      <h2 id="explora">Explora Ottoke</h2>
      <ul>
        {explore.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <nav class="footer__nav" aria-labelledby="encuentra">
      <h2 id="encuentra">Nos encontramos</h2>
      <ul>
        {
          meet.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 16 16" width="20" height="20" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={link.icon} />
                </svg>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="footer__bottom">
    <p>© 2026 {site.name}</p>
    <a href="#top">Volver arriba</a>
  </div>
</footer>
