---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import HairpinCard from '../../components/HairpinCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import { horquillas, price } from '../../data/horquillas.js';
import { norigae } from '../../data/norigae.js';
import { site, whatsapp } from '../../data/site.js';
import { productos } from '../../data/productos.js';

// Built like a norigae page (the same gallery, buying column, tabs and Más productos), so every
// next hairpin is an entry in the data file, and gets its page from it.
export function getStaticPaths() {
  return horquillas.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
// the names are the client's own titles: they keep their capitals
const lower = item.name;
const lead = productos.lead_horquilla;
const title = `Horquilla ${lower} | Ottoke Medellín`;
// the lead's season note is left out so the description stays under 160 characters (SEO-AI.md, point 5)
const description = `Horquilla ${lower} de Ottoke, en ${site.city}. ${productos.descripcion_horquillas} ${price.display}. Consulta disponibilidad por WhatsApp.`;
// sold out: the button asks to be told when it is back (the console's "Disponible" switch)
const ask = whatsapp(item.available ? `Hola Ottoke, quiero saber si la horquilla ${item.name} está disponible.` : `Hola Ottoke, avísame cuando vuelva la horquilla ${item.name}.`);
const others = horquillas.filter((other) => other.slug !== item.slug);
// "Más productos": the other hairpins and the norigae, taking turns
const more = Array.from({ length: Math.max(others.length, norigae.length) }, (_, i) => ({ horquilla: others[i], norigae: norigae[i] }));
const slides = item.photos.length;

// The client has given no materials or origin for the hairpins yet, so the
// answers say only what the first talk and the photos show. FAQPage below repeats them.
const groups = [
  {
    id: 'horquilla',
    label: 'La horquilla',
    // a hairpin with a stone
    icon: 'M3 13 9.5 6.5M9.5 6.5a2 2 0 1 0 2.8-2.8 2 2 0 0 0-2.8 2.8z',
    folds: [
      ...productos.preguntas_horquillas,
    ],
  },
  {
    id: 'pedido',
    label: 'Pedido',
    // a parcel
    icon: 'M2.5 5.5 8 3l5.5 2.5v5.5L8 13.5 2.5 11zM2.5 5.5 8 8l5.5-2.5M8 8v5.5',
    folds: [
      ...productos.pedido_horquillas,
      {
        question: '¿Está disponible?',
        answer: item.available ? 'Sí, la tenemos. Escríbenos por WhatsApp para pedirla.' : 'Por ahora está agotada. Escríbenos y te avisamos cuando vuelva.',
      },
      { question: '¿Hacen envíos?', answer: site.shipping },
      { question: '¿Cómo pago?', answer: site.payment },
    ],
  },
];
const folds = groups.flatMap((group) => group.folds);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `Horquilla ${lower}`,
    description: lead,
    image: new URL(item.og, Astro.site).href,
    brand: { '@type': 'Brand', name: site.name },
    offers: {
      '@type': 'Offer',
      price: price.value,
      priceCurrency: price.currency,
      availability: `https://schema.org/${item.available ? 'InStock' : 'OutOfStock'}`,
      url: new URL(Astro.url.pathname, Astro.site).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: folds.map((fold) => ({
      '@type': 'Question',
      name: fold.question,
      acceptedAnswer: { '@type': 'Answer', text: fold.answer },
    })),
  },
];
---

<Base title={title} description={description} image={item.og} jsonLd={jsonLd}>
  <Header slot="header" />
  <section class="product" aria-labelledby="titulo">
    <div class="gallery" id="galeria" style={`--slides:${slides}`}>
      <ul class="gallery__track" id="fotos" tabindex="0" aria-label={`Fotos de la horquilla ${lower}`}>
        {
          item.photos.map((photo, index) => (
            <li class="gallery__slide">
              <span class={photo.src === item.cutout ? 'panel panel--photo panel--cutout' : 'panel panel--photo'}>
                <Image src={photo.src} alt={photo.alt} widths={[600, 1000, 1254]} sizes="(min-width: 960px) 55vw, 100vw" format="webp" loading={index === 0 ? 'eager' : 'lazy'} />
              </span>
            </li>
          ))
        }
      </ul>
      {
        slides > 1 && (
          <>
            <button class="gallery__arrow gallery__arrow--prev" id="anterior" type="button" aria-label="Foto anterior" hidden>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
            </button>
            <button class="gallery__arrow gallery__arrow--next" id="siguiente" type="button" aria-label="Foto siguiente">
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
            </button>
          </>
        )
      }
      <p class="gallery__bar" id="cuenta" aria-live="polite">1 / {slides}</p>
    </div>

    <div class="product__info stack">
      <h1 id="titulo">Horquilla {lower}</h1>
      <p class="lead">{lead}</p>
      <p class="price">{price.display}{!item.available && <span class="sold-out">Agotado</span>}</p>
      <div class="actions">
        <a class="button" href={ask} target="_blank" rel="noopener noreferrer">
          {item.available ? 'Preguntar por WhatsApp' : 'Avísame cuando vuelva'}
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3h12v8H7l-3 3v-3H2z" /></svg>
        </a>
        <a class="button button--outline" href={site.dm} target="_blank" rel="noopener noreferrer">
          Escribir por DM
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
        </a>
      </div>

      <div class="tabs">
        <fieldset class="tabs__list" aria-label="Preguntas">
          {
            groups.map((group, index) => (
              <>
                <input class="tabs__radio" type="radio" name="preguntas" id={`preguntas-${group.id}`} checked={index === 0} />
                <label class="tabs__tab" for={`preguntas-${group.id}`}>
                  {group.label}
                  <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d={group.icon} /></svg>
                </label>
              </>
            ))
          }
        </fieldset>
        {
          groups.map((group) => (
            <div class="tabs__panel">
              {group.folds.map((fold) => (
                <details class="fold">
                  <summary>{fold.question}</summary>
                  <p>{fold.answer}</p>
                </details>
              ))}
            </div>
          ))
        }
      </div>

      <p><a href="/horquillas/">Ver todas las horquillas</a></p>
    </div>
  </section>

  <section class="band band--more torn torn--top"aria-labelledby="mas" style={`--thread:${item.thread}`}>
    <div class="wrap">
      <h2 class="band__head" id="mas">Más productos</h2>
      <ul class="cards cards--row">
        {more.map(({ horquilla: h, norigae: n }) => <>{h && <li><HairpinCard item={h} /></li>}{n && <li><ProductCard item={n} /></li>}</>)}
        <li>
          <a class="cards__all" href="/products/">
            Ver todos los productos
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <script>
    import '../../scripts/product.js';
  </script>
</Base>
