---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Piece from '../../components/Piece.astro';
import ProductCard from '../../components/ProductCard.astro';
import HairpinCard from '../../components/HairpinCard.astro';
import { norigae, price } from '../../data/norigae.js';
import { horquillas } from '../../data/horquillas.js';
import { site, whatsapp } from '../../data/site.js';
import { productos } from '../../data/productos.js';

// one page per norigae in the data file
export function getStaticPaths() {
  return norigae.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const lower = item.name.toLowerCase();
const title = `Norigae ${lower} tejido a mano en ${site.city} | Ottoke`;
const description = `Norigae ${lower}: amuleto coreano tejido a mano en ${site.city}. ${item.wish} ${price.display}.`;
// sold out: the button asks to be told when it is back (the console's "Disponible" switch)
const order = whatsapp(item.available ? `Hola Ottoke, quiero pedir el norigae ${item.name}.` : `Hola Ottoke, avísame cuando vuelva el norigae ${item.name}.`);
const others = norigae.filter((other) => other.slug !== item.slug);
// "Más productos": the other norigae and the hairpins, taking turns
const more = Array.from({ length: Math.max(others.length, horquillas.length) }, (_, i) => ({ norigae: others[i], horquilla: horquillas[i] }));
// the cut-out piece first, then the photos in the order set in the console
const slides = 1 + item.fotos.length;

// two tabs of questions: about the piece and about getting it.
// The same questions and answers go into FAQPage below
const groups = [
  {
    id: 'norigae',
    label: 'El norigae',
    // a tassel on its cord
    icon: 'M8 1.5V5M5.8 7.2a2.2 2.2 0 0 1 4.4 0zM5.8 7.2 5 14.5h6l-.8-7.3M7.1 9.5v5M8.9 9.5v5',
    folds: [
      {
        question: '¿Qué significa?',
        answer: `${item.wish} Como todos los norigae, lleva el nudo crisantemo, símbolo de protección.`,
      },
      ...productos.preguntas_norigae,
    ],
  },
  {
    id: 'pedido',
    label: 'Pedido y envío',
    // a parcel
    icon: 'M2.5 5.5 8 3l5.5 2.5v5.5L8 13.5 2.5 11zM2.5 5.5 8 8l5.5-2.5M8 8v5.5',
    folds: [
      ...productos.pedido_norigae,
      { question: '¿Hacen envíos?', answer: site.shipping },
      { question: '¿Cómo pago?', answer: site.payment },
    ],
  },
];
const folds = groups.flatMap((group) => group.folds);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `Norigae ${lower}`,
    description: `${item.wish} Amuleto coreano tejido a mano en ${site.city}.`,
    image: new URL(item.og, Astro.site).href,
    brand: { '@type': 'Brand', name: site.name },
    offers: {
      '@type': 'Offer',
      price: price.value,
      priceCurrency: price.currency,
      availability: `https://schema.org/${item.available ? 'InStock' : 'OutOfStock'}`,
      url: new URL(Astro.url.pathname, Astro.site).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: folds.map((fold) => ({
      '@type': 'Question',
      name: fold.question,
      acceptedAnswer: { '@type': 'Answer', text: fold.answer },
    })),
  },
];
---

<Base title={title} description={description} image={item.og} jsonLd={jsonLd}>
  <Header slot="header" />
  <section class="product" aria-labelledby="titulo">
    <div class="gallery" id="galeria" style={`--slides:${slides}`}>
      <ul class="gallery__track" id="fotos" tabindex="0" aria-label={`Fotos del norigae ${lower}`}>
        <li class="gallery__slide">
          <span class="panel panel--pattern panel--on panel--sway" style={`--thread:${item.thread}; --icon:var(--icon-${item.pattern})`}>
            <Piece item={item} alt={`Norigae ${lower}`} loading="eager" />
          </span>
        </li>
        {
          item.fotos.map((foto) => (
            <li class="gallery__slide">
              <span class="panel panel--photo">
                <Image src={foto.src} alt={foto.alt} widths={[600, 1000, 1600]} sizes="(min-width: 960px) 55vw, 100vw" format="webp" />
              </span>
            </li>
          ))
        }
      </ul>
      {
        slides > 1 && (
          <>
            <button class="gallery__arrow gallery__arrow--prev" id="anterior" type="button" aria-label="Foto anterior" hidden>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
            </button>
            <button class="gallery__arrow gallery__arrow--next" id="siguiente" type="button" aria-label="Foto siguiente">
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
            </button>
          </>
        )
      }
      <p class="gallery__bar" id="cuenta" aria-live="polite">1 / {slides}</p>
    </div>

    <div class="product__info stack">
      <h1 id="titulo">Norigae {lower}</h1>
      <p class="lead">{item.wish}</p>
      <p class="price">{price.display}{!item.available && <span class="sold-out">Agotado</span>}</p>
      <div class="actions">
        <a class="button" href={order} target="_blank" rel="noopener noreferrer">
          {item.available ? 'Pedir por WhatsApp' : 'Avísame cuando vuelva'}
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3h12v8H7l-3 3v-3H2z" /></svg>
        </a>
        <a class="button button--outline" href={site.dm} target="_blank" rel="noopener noreferrer">
          Escribir por DM
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
        </a>
      </div>
      <p>Un amuleto coreano para llevar en el celular o en la cartera.</p>

      <div class="tabs">
        <fieldset class="tabs__list" aria-label="Preguntas">
          {
            groups.map((group, index) => (
              <>
                <input class="tabs__radio" type="radio" name="preguntas" id={`preguntas-${group.id}`} checked={index === 0} />
                <label class="tabs__tab" for={`preguntas-${group.id}`}>
                  {group.label}
                  <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d={group.icon} /></svg>
                </label>
              </>
            ))
          }
        </fieldset>
        {
          groups.map((group) => (
            <div class="tabs__panel">
              {group.folds.map((fold) => (
                <details class="fold">
                  <summary>{fold.question}</summary>
                  <p>{fold.answer}</p>
                </details>
              ))}
            </div>
          ))
        }
      </div>

      <ul class="swatches" aria-label="Diseños">
        {
          norigae.map((other) => {
            const current = other.slug === item.slug;
            return (
              <li>
                <a
                  class="swatch"
                  href={`/norigae/${other.slug}/`}
                  style={`--thread:${other.thread}`}
                  aria-current={current ? 'page' : undefined}
                >
                  {other.name}
                  {
                    !current && (
                      <span class="swatch__preview panel panel--pattern panel--on" style={`--icon:var(--icon-${other.pattern})`}>
                        <Piece item={other} alt="" />
                      </span>
                    )
                  }
                </a>
              </li>
            );
          })
        }
        <li>
          <a class="swatch swatch--more" href="/norigae/">
            Ver más norigae
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="band band--more torn torn--top"aria-labelledby="mas" style={`--thread:${item.thread}`}>
    <div class="wrap">
      <h2 class="band__head" id="mas">Más productos</h2>
      <ul class="cards cards--row">
        {more.map(({ norigae: n, horquilla: h }) => <>{n && <li><ProductCard item={n} /></li>}{h && <li><HairpinCard item={h} /></li>}</>)}
        <li>
          <a class="cards__all" href="/products/">
            Ver todos los productos
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <script>
    import '../../scripts/product.js';
  </script>
</Base>
